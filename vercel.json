{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "corepack enable && corepack prepare pnpm@12.11.2 --activate && pnpm install",
  "buildCommand": "pnpm generate",
  "outputDirectory": ".output/public",
  "routes": [{ "handle": "filesystem" }, { "src": "/.*", "dest": "/200.html" }]
}
